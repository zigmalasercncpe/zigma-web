---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductsGallery from '../components/ProductsGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/content.js';
---

<Layout title="Máquinas CNC">
  <PageHeader
    eyebrow="Catálogo"
    title="Máquinas CNC con verificación dimensional"
    description="Cada equipo se entrega probado, con reporte de verificación y garantía. Asesoría para elegir la máquina exacta para su producción."
  />

  <section class="border-b border-white/5 py-16">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden border border-white/5 bg-white/5 md:grid-cols-4">
      <div class="bg-forged p-6 text-center">
        <p class="font-mono text-3xl font-medium text-copper">120+</p>
        <p class="mt-2 text-[12px] uppercase tracking-wider text-steelgrey">Máquinas entregadas</p>
      </div>
      <div class="bg-forged p-6 text-center">
        <p class="font-mono text-3xl font-medium text-copper">5</p>
        <p class="mt-2 text-[12px] uppercase tracking-wider text-steelgrey">Marcas homologadas</p>
      </div>
      <div class="bg-forged p-6 text-center">
        <p class="font-mono text-3xl font-medium text-copper">0</p>
        <p class="mt-2 text-[12px] uppercase tracking-wider text-steelgrey">Piezas rechazadas*</p>
      </div>
      <div class="bg-forged p-6 text-center">
        <p class="font-mono text-3xl font-medium text-copper">24h</p>
        <p class="mt-2 text-[12px] uppercase tracking-wider text-steelgrey">Respuesta técnica</p>
      </div>
    </div>
  </section>

  <ProductsGallery />

  <section class="border-t border-white/5 py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <h2 class="font-serif text-3xl font-semibold text-coldwhite md:text-4xl">¿No sabe qué máquina necesita?</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-steelgrey">Complete el formulario con su material, pieza y volumen de producción. Nuestros ingenieros le propondrán la configuración óptima con un análisis de retorno de inversión.</p>
      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        {['Verificación laser antes de entrega', 'Instalación y puesta en marcha', 'Capacitación del operador incluida'].map((f) => (
          <div class="flex items-center gap-3 border border-white/5 bg-gunmetal/40 p-5">
            <Icon name="check" size={16} class="shrink-0 text-copper" />
            <span class="text-sm text-coldwhite">{f}</span>
          </div>
        ))}
      </div>
      <div class="mt-10 overflow-hidden border border-white/5">
        <table class="w-full border-collapse font-mono text-[12px]">
          <thead>
            <tr class="bg-gunmetal text-left text-[11px] tracking-[0.2em] text-steelgrey uppercase">
              <th class="p-4">Modelo</th>
              <th class="p-4">Tipo</th>
              <th class="p-4">Recorrido / Capacidad</th>
              <th class="p-4">Husillo</th>
              <th class="p-4">Control</th>
            </tr>
          </thead>
          <tbody>
            {
              products.map((p) => (
                <tr class="border-t border-white/5 text-coldwhite transition-colors hover:bg-gunmetal/60">
                  <td class="p-4 text-copper">{p.model}</td>
                  <td class="p-4">{p.category}</td>
                  <td class="p-4 text-steelgrey">{p.specs[0]}</td>
                  <td class="p-4 text-steelgrey">{p.specs[2]}</td>
                  <td class="p-4 text-steelgrey">{p.specs[3]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <ContactForm />
</Layout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
