---
const { eyebrow, title, description } = Astro.props;
---

<header class="relative overflow-hidden border-b border-white/5 py-24 md:py-32">
  <div class="absolute inset-0 bg-grid"></div>
  <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-copper/10 blur-3xl"></div>
  <div class="relative mx-auto max-w-7xl px-6">
    <span class="inline-flex items-center gap-3 font-mono text-[12px] tracking-[0.3em] text-copper uppercase">
      <span class="h-px w-8 bg-copper/60"></span> {eyebrow}
    </span>
    <h1 class="mt-6 max-w-3xl font-serif text-4xl font-semibold leading-tight text-coldwhite md:text-6xl">{title}</h1>
    {description && <p class="mt-6 max-w-2xl text-base leading-relaxed text-steelgrey md:text-lg">{description}</p>}
  </div>
</header>