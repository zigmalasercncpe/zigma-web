---
import { site } from '../data/content.js';
import Icon from './Icon.astro';
---

<section class="relative overflow-hidden border-t border-copper/20 py-24 md:py-32">
  <div class="absolute inset-0 bg-grid"></div>
  <div class="pointer-events-none absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-copper/15 blur-3xl"></div>
  <div class="relative mx-auto max-w-4xl px-6 text-center">
    <span class="inline-flex items-center gap-2 font-mono text-[12px] tracking-[0.3em] text-copper uppercase">
      <Icon name="target" size={14} /> {site.tagline}
    </span>
    <h2 class="mt-6 font-serif text-4xl font-semibold leading-tight text-coldwhite md:text-6xl">
      El momento de <span class="text-copper-gradient italic">precisar</span> es ahora.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-base text-steelgrey md:text-lg">
      Cuéntenos su necesidad de maquinaria CNC hoy. Le respondemos en 24 horas con una propuesta técnica y económica clara.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="/contacto" class="group inline-flex items-center gap-3 bg-copper px-10 py-4 font-mono text-[13px] tracking-[0.2em] text-forged uppercase transition-all duration-300 hover:bg-engorange">
        Solicitar cotización
        <Icon name="arrowRight" size={16} class="transition-transform duration-300 group-hover:translate-x-1.5" />
      </a>
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="inline-flex items-center gap-3 border border-white/10 px-10 py-4 font-mono text-[13px] tracking-[0.2em] text-coldwhite uppercase transition-all duration-300 hover:border-copper hover:text-copper">
        <Icon name="whatsapp" size={16} /> WhatsApp directo
      </a>
    </div>
  </div>
</section>
