---
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { name, size = 24, strokeWidth = 1.5, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  // Máquina CNC de 5 ejes (perfil de centro de mecanizado)
