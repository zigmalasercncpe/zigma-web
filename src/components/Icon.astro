  // Engranaje con check
  gear: `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/><path d="M9.2 12l2 2 3.6-3.8"/>`,
  // Capacitación (monitor con código)
  training: `<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M6 9l2.5 2L6 13"/><path d="M11 13h6"/><path d="M9 20h6M12 16v4"/>`,
  // Herramienta / mantenimiento + latido
  wrench: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/><path d="M2.5 12h2.5l1.5-3 3 5 2-3.5h4"/>`,
  // Calendario
  calendar: `<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>`,
  // Reloj
  clock: `<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>`,
  // Usuarios
  users: `<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>`,
  // Check
  check: `<path d="M20 6L9 17l-5-5"/>`,
  // Check círculo
  checkCircle: `<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>`,
  // Flecha derecha
  arrowRight: `<path d="M4 12h16M13 5l7 7-7 7"/>`,
  // Teléfono
  phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.81.34 1.6.65 2.36a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.72-1.72a2 2 0 0 1 2.11-.45c.76.31 1.55.53 2.36.65A2 2 0 0 1 22 16.92z"/>`,
  // Correo
  mail: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 6L2 7"/>`,
  // Ubicación
  mapPin: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
  // WhatsApp
  whatsapp: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/><path d="M9 10a2 2 0 0 0 2.5 1.9c.4-.2.7-.5.9-.9a2 2 0 0 0-2.5-2.9M15 14a2 2 0 0 0-1.9 2.5c.2.4.5.7.9.9a2 2 0 0 0 2.9-2.5"/>`,
  // LinkedIn
  linkedin: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>`,
  // YouTube
  youtube: `<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><path d="M9.75 15.02l5.75-3.27-5.75-3.27z"/>`,
  // Menú
  menu: `<path d="M3 6h18M3 12h18M3 18h18"/>`,
  // Cerrar
  close: `<path d="M18 6L6 18M6 6l12 12"/>`,
  // Documento / plano
  document: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/>`,
  // Sello de certificación
  badge: `<circle cx="12" cy="10" r="6"/><path d="M9 10l2 2 4-4"/><path d="M8.5 14.5L7 22l5-3 5 3-1.5-7.5"/>`,
  // Crosshair
  crosshair: `<circle cx="12" cy="12" r="8"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>`,
  // Chispas (plasma/láser)
  spark: `<path d="M12 2l1.8 5.7L20 12l-6.2 4.3L12 22l-1.8-5.7L4 12l6.2-4.3z"/><path d="M5 4l.8 2.2L8 7l-2.2.8L5 10l-.8-2.2L2 7l2.2-.8z"/>`,
  // Send / enviar
  send: `<path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/>`,
  // Chevron
  chevronDown: `<path d="M6 9l6 6 6-6"/>`,
  // Upload
  upload: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>`,
  // Shield
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  // Target / precisión
  target: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>`,
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={icons[name] || icons.crosshair}
></svg>
