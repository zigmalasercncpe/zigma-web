---
import { site } from '../data/content.js';
---

<a href="/" class="group inline-flex items-center gap-3" aria-label={site.name}>
  <svg width="42" height="42" viewBox="0 0 64 64" fill="none" class="shrink-0 transition-transform duration-300 group-hover:scale-105">
    <rect x="4" y="4" width="56" height="56" rx="8" stroke="#B87333" stroke-width="3.5"/>
    <path d="M16 23 L48 23 L20 41 L48 41" stroke="#F0F2F4" stroke-width="3.5" stroke-linecap="square" stroke-linejoin="miter"/>
    <circle cx="12" cy="12" r="3" fill="#E86E2C"/>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-sans text-[22px] font-bold tracking-[0.18em] text-coldwhite">
      ZIG<span class="font-mono font-medium text-copper">TEC</span>
    </span>
    <span class="mt-1 font-mono text-[8px] tracking-[0.32em] text-steelgrey uppercase">Precision CNC</span>
  </span>
</a>
