---
import { site, nav } from '../data/content.js';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="bg-footer text-steelgrey">
  <div class="mx-auto max-w-7xl px-6 pt-20 pb-10">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div>
        <Logo />
        <p class="mt-6 max-w-xs text-sm leading-relaxed">
          {site.tagline}
        </p>
        <div class="mt-6 flex gap-3">
          <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp" class="flex h-10 w-10 items-center justify-center border border-white/10 transition-colors hover:border-copper hover:text-copper"><Icon name="whatsapp" size={16} /></a>
          <a href="#" aria-label="LinkedIn" class="flex h-10 w-10 items-center justify-center border border-white/10 transition-colors hover:border-copper hover:text-copper"><Icon name="linkedin" size={16} /></a>
          <a href="#" aria-label="YouTube" class="flex h-10 w-10 items-center justify-center border border-white/10 transition-colors hover:border-copper hover:text-copper"><Icon name="youtube" size={16} /></a>
        </div>
      </div>

      <!-- Navegación -->
      <div>
        <h3 class="font-mono text-[11px] tracking-[0.3em] text-coldwhite uppercase">Navegación</h3>
        <ul class="mt-6 space-y-3 text-sm">
          {nav.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-copper">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="font-mono text-[11px] tracking-[0.3em] text-coldwhite uppercase">Servicios</h3>
        <ul class="mt-6 space-y-3 text-sm">
          <li><a href="/productos" class="transition-colors hover:text-copper">Venta de Máquinas CNC</a></li>
          <li><a href="/servicios" class="transition-colors hover:text-copper">Servicios Técnicos</a></li>
          <li><a href="/cursos" class="transition-colors hover:text-copper">Cursos y Capacitaciones</a></li>
          <li><a href="/mantenimiento" class="transition-colors hover:text-copper">Reparación y Mantenimiento</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-mono text-[11px] tracking-[0.3em] text-coldwhite uppercase">Contacto</h3>
        <ul class="mt-6 space-y-4 text-sm">
          <li class="flex gap-3"><Icon name="phone" size={16} class="mt-0.5 shrink-0 text-copper" /><a href={`tel:${site.phone}`} class="transition-colors hover:text-copper">{site.phoneDisplay}</a></li>
          <li class="flex gap-3"><Icon name="mail" size={16} class="mt-0.5 shrink-0 text-copper" /><a href={`mailto:${site.email}`} class="transition-colors hover:text-copper">{site.email}</a></li>
          <li class="flex gap-3"><Icon name="mapPin" size={16} class="mt-0.5 shrink-0 text-copper" /><span>{site.address}</span></li>
          <li class="flex gap-3"><Icon name="clock" size={16} class="mt-0.5 shrink-0 text-copper" /><span>{site.hours}</span></li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 font-mono text-[11px] tracking-wider md:flex-row">
      <span>© {year} {site.name}. Todos los derechos reservados.</span>
      <span class="flex items-center gap-2"><Icon name="target" size={12} class="text-copper" /> Precisión garantizada · ±0.002 mm</span>
    </div>
  </div>
</footer>
