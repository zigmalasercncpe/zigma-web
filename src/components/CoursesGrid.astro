---
import { courses } from '../data/content.js';
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
const colorMap = { steelblue: 'text-steelblue border-steelblue/30', copper: 'text-copper border-copper/40', engorange: 'text-engorange border-engorange/40' };
---

<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <SectionTitle
      eyebrow="Capacitación"
      title="Formación certificada en máquina real"
      description="Cursos cortos, prácticos e intensivos. Números reducidos por aula y práctica en centros de mecanizado reales."
    />

    <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        courses.map((c) => (
          <article class:list={[
            'reveal group relative flex flex-col border p-8 transition-all duration-500',
            c.featured ? 'border-copper/50 bg-gunmetal shadow-[0_0_60px_rgba(184,115,51,0.12)]' : 'border-white/5 bg-gunmetal/40 hover:border-copper/40',
          ]}>
            {c.featured && (
              <span class="absolute -top-3 left-8 bg-copper px-3 py-1 font-mono text-[10px] tracking-[0.25em] text-forged uppercase">Más solicitado</span>
            )}
            <div class="flex items-center justify-between">
              <span class={`border px-3 py-1 font-mono text-[11px] tracking-[0.2em] uppercase ${colorMap[c.levelColor]}`}>{c.level}</span>
              <span class="flex items-center gap-2 font-mono text-[11px] text-steelgrey"><Icon name="users" size={13} /> {c.seats}</span>
            </div>
            <h3 class="mt-6 font-serif text-2xl font-semibold text-coldwhite">{c.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-steelgrey">{c.description}</p>
            <div class="mt-6 space-y-2 border-t border-white/5 pt-5 font-mono text-[12px] text-steelgrey">
              <p class="flex items-center gap-2"><Icon name="calendar" size={13} class="text-copper" /> {c.date}</p>
              <p class="flex items-center gap-2"><Icon name="clock" size={13} class="text-copper" /> {c.duration}</p>
            </div>
            <a href="/cursos" class="mt-6 inline-flex items-center gap-2 font-mono text-[12px] tracking-[0.2em] text-copper uppercase transition-colors hover:text-engorange">
              Reservar cupo <Icon name="arrowRight" size={14} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
