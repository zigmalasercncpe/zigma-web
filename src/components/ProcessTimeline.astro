---
import { process } from '../data/content.js';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';
---

<section class="relative border-t border-white/5 bg-gunmetal/20 py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <SectionTitle
      eyebrow="Metodología"
      title="De la consulta al seguimiento: un proceso sin fisuras"
      description="Cinco pasos, cero improvisación. Así aseguramos que cada proyecto llegue a tiempo y con la tolerancia prometida."
      align="center"
    />

    <div class="mt-20 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
      {
        process.map((p, i) => (
          <div class="reveal group relative">
            <div class="relative">
              <span class="block font-mono text-5xl font-medium text-copper/30 transition-colors duration-500 group-hover:text-copper/70">{p.step}</span>
              <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-serif text-[64px] font-bold text-white/5">{p.step}</span>
            </div>
            <h3 class="mt-6 font-sans text-lg font-semibold tracking-wide text-coldwhite">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-steelgrey">{p.description}</p>
            {i < process.length - 1 && (
              <span class="absolute -right-5 top-8 hidden text-copper/40 lg:block"><Icon name="arrowRight" size={16} /></span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
