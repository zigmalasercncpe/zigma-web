---
// Plano técnico de centro de mecanizado CNC que se "dibuja" solo.
// Para reemplazar por video: cambia este componente en Hero.astro.
const lines = {
  column: 'M380 440 V130 H470 V440',
  head: 'M300 130 H470 V200 H300 Z',
  spindle: 'M330 200 V270',
  tool: 'M322 270 L338 270 M330 270 V300 M323 300 L337 300',
  base: 'M60 440 H560 V475 H60 Z',
  table: 'M60 355 H320 V440 H60 Z',
  workpiece: 'M130 355 V320 H230 V355',
  tline1: 'M380 130 V110 M470 130 V110 M425 110',
  tline2: 'M300 200 H280 M470 200 H490',
};
---

<svg viewBox="0 0 640 520" fill="none" class="w-full max-w-[640px] drop-shadow-[0_0_60px_rgba(184,115,51,0.08)]">
  <!-- Marco exterior -->
  <rect x="14" y="14" width="612" height="492" stroke="rgba(240,242,244,0.12)" pathLength="1200" class="blueprint-line delay-1"/>
  <path d="M14 60 H14" stroke="rgba(240,242,244,0.12)" pathLength="1200" class="blueprint-line"/>

  <!-- Líneas de cota -->
  <path d="M60 492 V505 H560 V492" stroke="#B87333" opacity="0.8" pathLength="1200" class="blueprint-line delay-2"/>
  <path d="M34 90 V470 M40 90 V470" stroke="#B87333" opacity="0.8" pathLength="1200" class="blueprint-line delay-2"/>

  <!-- Ejes de máquina -->
  <path d={lines.column} stroke="#F0F2F4" stroke-width="1.6" opacity="0.85" pathLength="1200" class="blueprint-line"/>
  <path d={lines.head} stroke="#F0F2F4" stroke-width="1.6" opacity="0.85" pathLength="1200" class="blueprint-line delay-1"/>
  <path d={lines.spindle} stroke="#F0F2F4" stroke-width="1.4" opacity="0.85" pathLength="1200" class="blueprint-line delay-2"/>
  <path d={lines.tool} stroke="#E86E2C" stroke-width="1.4" opacity="0.9" pathLength="1200" class="blueprint-line delay-3"/>
  <path d={lines.base} stroke="#F0F2F4" stroke-width="1.6" opacity="0.85" pathLength="1200" class="blueprint-line delay-1"/>
  <path d={lines.table} stroke="#F0F2F4" stroke-width="1.5" opacity="0.85" pathLength="1200" class="blueprint-line delay-2"/>
  <path d={lines.workpiece} stroke="#4A7C9E" stroke-width="1.5" opacity="0.9" pathLength="1200" class="blueprint-line delay-3"/>

  <!-- Marcas de centrado -->
  <circle cx="230" cy="320" r="20" stroke="#4A7C9E" opacity="0.6" pathLength="1200" class="blueprint-line delay-3"/>
  <path d="M230 296 V280 M230 360 V376 M206 320 H190 M254 320 H270" stroke="#4A7C9E" opacity="0.5" pathLength="1200" class="blueprint-line delay-3"/>

  <!-- Flechas de ejes -->
  <path d="M40 40 L70 40 M60 32 L70 40 L60 48" stroke="#B87333" pathLength="1200" class="blueprint-line delay-2"/>
  <path d="M40 40 V70 M32 60 L40 70 L48 60" stroke="#B87333" pathLength="1200" class="blueprint-line delay-2"/>
  <path d="M585 480 L585 450 M577 460 L585 450 L593 460" stroke="#B87333" pathLength="1200" class="blueprint-line delay-2"/>

  <!-- Textos técnicos -->
  <g font-family="JetBrains Mono, monospace" class="bp-fade">
    <text x="42" y="286" font-size="12" fill="#B87333">Z</text>
    <text x="585" y="468" font-size="12" fill="#B87333">X</text>
    <text x="222" y="446" font-size="12" fill="#8A9099">Y</text>
    <text x="104" y="500" font-size="11" fill="#8A9099">1 050</text>
    <text x="24" y="300" font-size="11" fill="#8A9099" transform="rotate(-90 24 300)">2 400</text>
    <text x="140" y="342" font-size="10" fill="#4A7C9E">PIEZA</text>
    <text x="560" y="260" font-size="10" fill="#E86E2C">HERRAMIENTA</text>
    <text x="350" y="96" font-size="10" fill="#8A9099">CABEZAL 12.000 RPM</text>
    <text x="330" y="320" font-size="10" fill="#F0F2F4">±0.002 mm</text>

    <!-- Rotulación / cartela -->
    <rect x="392" y="430" width="218" height="66" stroke="rgba(240,242,244,0.25)" fill="rgba(34,38,43,0.6)"/>
    <text x="404" y="452" font-size="12" fill="#F0F2F4" font-weight="700" letter-spacing="2">ZIGTEC</text>
    <text x="404" y="468" font-size="9" fill="#8A9099" letter-spacing="1">CENTRO DE MECANIZADO</text>
    <text x="404" y="481" font-size="9" fill="#B87333">ZT-5X 500 · REV A · ESC 1:1</text>
  </g>
</svg>

<style>
  .bp-fade {
    opacity: 0;
    animation: bpFade 0.6s ease forwards 2.6s;
  }
  @keyframes bpFade {
    to { opacity: 1; }
  }
</style>
